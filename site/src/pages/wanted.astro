---
import Base from "../layouts/Base.astro";
import StatusBadge from "../components/StatusBadge.astro";
import Icon from "../components/Icon.astro";
import { db, deviceUrl } from "../lib/data.ts";
import { openWanted } from "../lib/wanted.ts";
import { displayName } from "../lib/config.ts";
import { wantedIssueUrl } from "@opendevicedb/core";

const list = await openWanted();
const { index } = db();
const status = new Map(index.map((e) => [e.id, e.status]));
const people = list.reduce((n, w) => n + w.votes, 0);
---
<Base title="Wanted devices" description="Devices people want reverse engineered or supported, ranked by interest. Add a 👍 to the request to count yourself in.">
  <h1>Wanted</h1>
  <p class="lede">
    Devices people would like to use with open code, ranked by how many want them.
    If you can reverse engineer one, this is where your work helps the most people:{" "}
    <a href="/contribute/#claims">claim it</a> first, then publish your findings.
  </p>
  <div class="actions">
    <a class="btn primary" href={wantedIssueUrl({})}>Request a device</a>
    <a class="btn" href="/api/wanted.json">wanted.json</a>
  </div>
  <p class="small muted">
    A request is a GitHub issue (a GitHub account is needed, and requests are public).
    Already requested? Add a 👍 to its issue: that is how interest is counted.
    A request closes by itself when a usable result reaches the directory.
  </p>

  <div class="results-bar"><span>{list.length.toLocaleString("en")} open request{list.length === 1 ? "" : "s"} · {people.toLocaleString("en")} interested</span></div>
  {list.length === 0 ? (
    <p class="empty">No open request yet. Looking for a device that is not in the directory? <a href={wantedIssueUrl({})}>Request it</a>.</p>
  ) : (
    <ul class="list-plain results">
      {list.map((w) => (
        <li>
          <div class="dev-row">
            <a class="name" href={w.inRegistry ? deviceUrl(w.id) : w.url}>{displayName(w.vendor, w.model)}</a>
            <span class="row">
              <a class="badge wanted" href={w.url} title="Add a 👍 on the request to count yourself in"><Icon name="wanted-ThumbsUp" size={20} />{w.votes} want{w.votes === 1 ? "s" : ""} it</a>
              {w.inRegistry && <StatusBadge status={status.get(w.id)!} />}
            </span>
            <span class="meta">
              {w.category ?? "uncategorised"} · <span class="mono">{w.id}</span> · requested {w.opened}
              {w.issues.length > 1 && <> · {w.issues.length} requests</>}
              {" · "}<a href={w.url}>request #{w.issues[0]}</a>
            </span>
          </div>
        </li>
      ))}
    </ul>
  )}
</Base>
