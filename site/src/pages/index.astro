---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import SearchBar from "../components/SearchBar.astro";
import SearchSuggestions from "../components/SearchSuggestions.astro";
import DeviceCard from "../components/DeviceCard.astro";
import WantedItem from "../components/WantedItem.astro";
import FeatureItem from "../components/FeatureItem.astro";
import ExploreCard from "../components/ExploreCard.astro";
import PostItem from "../components/PostItem.astro";
import CtaBanner from "../components/CtaBanner.astro";
import { counts, activeClaims, latestCurated, effectiveStatus, db } from "../lib/data.ts";
import { posts } from "../lib/news.ts";
import { fmtLongDate } from "../lib/dates.ts";
import { openWanted } from "../lib/wanted.ts";

const c = counts();
const claims = activeClaims().slice(0, 4);
const news = (await posts()).slice(0, 3);
const latest = latestCurated(6);
const fmt = (n: number) => n.toLocaleString("en");
const { on } = db();
const mostWanted = (await openWanted()).slice(0, 3);
---
<Base bleed>
  <link slot="head" rel="preload" as="image" href="/images/hero.webp" media="(min-width: 80rem)" fetchpriority="high" />
  <div class="hero-wrap">
    <section class="section hero">
      <!-- The illustration sits behind the hero only (cut off at the stats bar) and is sized so
           the devices stay beside the search bar. Below 80rem (1280px) only slivers of them would show, so the
           source is a 1px placeholder there and the art is never downloaded. -->
      <picture>
        <source media="(min-width: 80rem)" srcset="/images/hero.webp" />
        <img class="hero-art" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" alt="" width="1902" height="827" fetchpriority="high" />
      </picture>
      <div class="inner narrow">
        <div class="hero-text stack-md">
          <p class="eyebrow">A free, community-built device database</p>
          <h1>Find open firmware, tools, and research for your devices.</h1>
          <p class="lede">
            Search thousands of devices to see what's available, find existing projects, and check what the
            community is working on.
          </p>
        </div>
        <form role="search" action="/devices/" method="get" class="hero-search">
          <SearchBar id="home-q" />
        </form>
        <SearchSuggestions />
      </div>
    </section>

    <div class="stats-bar">
      <div class="counters" aria-label="Directory counters">
        <a class="counter" href="/devices/"><strong>{fmt(c.devices)}</strong><span>Devices</span></a>
        <a class="counter" href="/sources/"><strong>{fmt(c.sources)}</strong><span>Aggregated sources</span></a>
        <a class="counter" href="/devices/?status=open-firmware"><strong>{fmt(c.byStatus["open-firmware"])}</strong><span>Open firmware</span></a>
        <a class="counter" href="/devices/?status=controllable"><strong>{fmt(c.byStatus.controllable)}</strong><span>Controllable</span></a>
        <a class="counter" href="/devices/?status=in-progress"><strong>{fmt(c.byStatus["in-progress"])}</strong><span>In progress</span></a>
      </div>
    </div>
  </div>

  <!-- Intro: stacked = text, features, buttons; from 48rem text + buttons left, features right. -->
  <section class="section">
    <div class="intro">
      <div class="intro-text stack-md">
        <h2 class="section-title">Build on what matters.</h2>
        <p class="lede">
          OpenDeviceDB brings scattered device research, open firmware, and protocols into one searchable
          directory. Discover what's already been done, find what's missing, and help others build on your work.
        </p>
      </div>
      <div class="intro-actions row">
        <a class="btn primary lg" href="/contribute/">How to contribute</a>
        <a class="btn lg" href="/agents/">View documentation</a>
      </div>
      <div class="features">
        <FeatureItem icon="time" title="Save research time">Find existing tools, firmware, and research before starting your own.</FeatureItem>
        <FeatureItem icon="unlock" title="Find where you're needed">See what's already documented and where there's still work to do.</FeatureItem>
        <FeatureItem icon="ai-editing" title="Make your findings useful">Share your discoveries so others can continue where you left off.</FeatureItem>
        <FeatureItem icon="book-open" title="Keep knowledge open">Help maintain a community-driven resource anyone can access and improve.</FeatureItem>
      </div>
    </div>
  </section>

  <section class="section center">
    <div class="inner">
      <h2 class="section-title">New here? Three ways to explore.</h2>
      <div class="card-grid cols-3">
        <ExploreCard image="/images/find-existing-work.webp" title="Find existing work" href="/devices/" cta="Browse devices">
          Search devices to discover available firmware, tools, and research before starting your own.
        </ExploreCard>
        <ExploreCard image="/images/identify-device.webp" title="Identify a device" href="/detect/" cta="Try device detection">
          Use a supported browser to identify compatible USB or Bluetooth devices.
        </ExploreCard>
        <ExploreCard image="/images/share-knowledge.webp" title="Share what you know" href="/contribute/" cta="Start contributing">
          Add a device, link existing research, or improve a record so others can build on it.
        </ExploreCard>
      </div>
    </div>
  </section>

  <section class="section center">
    <div class="inner">
      <h2 class="section-title">Recently updated devices</h2>
      {latest.length === 0 ? <p class="empty">No curated record yet.</p> : (
        <div class="card-grid cols-2">
          {latest.map((r) => (
            <DeviceCard record={r} status={effectiveStatus(r, on)} />
          ))}
        </div>
      )}
      <a class="btn primary" href="/devices/">View all devices</a>
    </div>
  </section>

  <section class="section">
    <div class="inner two-col">
      <div class="stack-lg">
        <h2 class="sub-title">Wanted devices</h2>
        {mostWanted.length === 0 ? (
          <p class="empty">No request yet. Can't find a device? <a href="/wanted/">Request it</a> and others can add a 👍.</p>
        ) : (
          <div class="cards">{mostWanted.map((w) => <WantedItem w={w} />)}</div>
        )}
        <a href="/wanted/">View all requests</a>
      </div>
      <div class="stack-lg">
        <h2 class="sub-title">Devices in progress</h2>
        {claims.length === 0 ? (
          <p class="muted">No live claim right now. Starting on a device? Claim it so nobody duplicates your work.</p>
        ) : (
          <div class="cards">
            {claims.map(({ record: r, claim }) => (
              <DeviceCard record={r} status={effectiveStatus(r, on)}>{claim.who} — {claim.scope} · until {fmtLongDate(claim.expires)}</DeviceCard>
            ))}
          </div>
        )}
        <a href="/contribute/#claims">How claims work</a>
      </div>
    </div>
  </section>

  <section class="section center">
    <div class="inner">
      <h2 class="section-title">Latest news</h2>
      {news.length === 0 ? <p class="empty">No news yet.</p> : (
        <div class="card-grid cols-3">{news.map((p) => <PostItem post={p} />)}</div>
      )}
      <a class="btn primary" href="/news/">Read all news</a>
    </div>
  </section>

  <section class="section center alt">
    <div class="inner code">
      <div class="stack-md">
        <h2 class="section-title">For AI agents</h2>
        <p class="lede">
          Agents can query OpenDeviceDB themselves before starting a reverse-engineering job, claim the device
          while they work, and publish their findings when done — through an MCP server.
        </p>
      </div>
      <pre><code>claude mcp add opendevicedb -- npx -y @opendevicedb/mcp</code></pre>
      <a class="btn white lg" href="/agents/">Set up an agent<Icon name="arrow-right" /></a>
    </div>
  </section>

  <CtaBanner />
</Base>

<style>
  .hero-wrap { overflow-x: clip; }
  .hero { position: relative; isolation: isolate; overflow: clip; }
  .hero-art { display: none; }
  @media (min-width: 80rem) {
    .hero-art {
      /* At the search bar's height, the camera ends at 30.8% of the art's width and the
         database starts at 77.1%: a 46.3% gap centred at 54%. Size the art so that gap is the
         search bar's width plus 32px each side, and centre the gap on the search bar. */
      display: block; position: absolute; z-index: -1; top: 0; left: 50%; max-width: none; height: auto;
      width: calc((min(960px, 100vw - 2 * var(--gutter)) + 64px) / 0.463);
      transform: translateX(-54%); opacity: 0.9; pointer-events: none;
    }
  }
  .hero { padding-top: 24px; }
  @media (min-width: 48rem) { .hero { padding-top: 48px; } }
  .hero .inner { align-items: center; text-align: center; gap: var(--space-stack-lg); }
  .hero-search { width: 100%; display: flex; justify-content: center; }

  .stats-bar { padding: 32px var(--gutter); border-block: 1px solid var(--color-border-subtle); background: var(--color-bg-subtle); backdrop-filter: blur(12px); }

  .intro { max-width: var(--max); margin: 0 auto; display: grid; gap: var(--space-stack-lg) var(--space-section-gap); }
  .intro-actions { order: 3; gap: 12px; }
  @media (min-width: 48rem) {
    .intro { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .intro-text { grid-column: 1; grid-row: 1; align-self: end; }
    .intro-actions { order: 0; grid-column: 1; grid-row: 2; align-self: start; }
    .features { grid-column: 2; grid-row: 1 / span 2; align-self: center; }
  }

  .two-col > .stack-lg { align-items: flex-start; }
  .two-col .cards { width: 100%; }
  .sub-title { margin: 0; font: 400 var(--text-heading-2) / 1.2 var(--font-display); }

  .inner.code :global(.code-block) { width: 100%; margin: 0; text-align: left; }
</style>
