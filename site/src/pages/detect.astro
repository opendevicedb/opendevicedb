---
// SPEC.md R1 "Device detection (v1)": read the id a plugged or nearby device announces
// (WebUSB / WebSerial vid:pid, Web Bluetooth name) and look it up in the static index, all in
// the browser. The island is scripts/detect.ts; the label search below works without it.
import Base from "../layouts/Base.astro";
import SearchBar from "../components/SearchBar.astro";
import Icon from "../components/Icon.astro";
import DesignImage from "../components/DesignImage.astro";
import "../styles/detect.css";
---
<Base title="Detect my device" description="Plug in a device or switch on its Bluetooth: this page reads the id it announces and finds it in OpenDeviceDB. Runs in your browser; nothing is sent anywhere.">
  <h1>Detect my device</h1>
  <p class="lede">
    Plug the device in, or switch on its Bluetooth, and this page reads the id it announces,
    then looks it up in the directory.
  </p>
  <p class="small muted detect-privacy">
    Everything runs in your browser: the id is matched against the
    <a href="/api/index.json">static index</a>, nothing is sent anywhere.
  </p>

  <section id="detect" aria-labelledby="detect-h">
    <h2 id="detect-h" class="sr-only">Detect</h2>
    <p id="unsupported" class="callout warn" hidden>
      Device detection works in <strong>Chrome or Edge</strong>, on desktop or Android, over https.
      <span id="unsupported-why"></span>
      Use the <a href="#label">label search</a> below instead.
    </p>
    <noscript>
      <p class="callout warn">Device detection needs JavaScript (Chrome or Edge). The <a href="#label">label search</a> below works without it.</p>
    </noscript>

    <div class="grid detect-ways">
      <div class="card stack detect-card usb-card">
        <DesignImage name="detect-Image80" width={56} height={56} />
        <h3>USB</h3>
        <p>Phones in fastboot or ADB mode, cameras, RGB peripherals, printer and maker boards.</p>
        <p><button class="btn primary" type="button" data-detect="usb" disabled>Connect a USB device</button></p>
        <p class="small muted">The browser lists the plugged devices; pick one. It only reads its id, nothing is opened or written.</p>
      </div>
      <div class="card stack detect-card">
        <DesignImage name="detect-Image81" width={56} height={56} />
        <h3>Bluetooth</h3>
        <p>Watches, bands, earbuds, lights and sensors that advertise a name.</p>
        <p><button class="btn" type="button" data-detect="bluetooth" disabled>Find a Bluetooth device</button></p>
        <p class="small muted">Wake the device or put it in pairing mode so it shows up. Nothing is paired.</p>
      </div>
      <div class="card stack detect-card">
        <DesignImage name="detect-Image82" width={56} height={56} />
        <h3>Serial port</h3>
        <p>A board or device wired through a USB-serial (UART) adapter.</p>
        <p><button class="btn" type="button" data-detect="serial" disabled>Pick a serial port</button></p>
        <p class="small muted">This identifies the adapter (CP210x, CH340, FTDI…), not what is wired to it.</p>
      </div>
    </div>

    <div id="out" class="detect-out" aria-live="polite" hidden>
      <h2 id="out-title" tabindex="-1">Result</h2>
      <div id="out-read"></div>
      <div id="out-notes"></div>
      <ul id="out-list" class="results list-plain" hidden></ul>
      <p id="out-next" class="small"></p>
    </div>
  </section>

  <section id="label" aria-labelledby="label-h">
    <h2 id="label-h">Search by the label</h2>
    <p>
      Routers, network cameras, plugs and Zigbee devices do not announce an id the browser can read.
      Look at the label or the box: model, <strong>FCC ID</strong>, SKU, or a USB <code>vid:pid</code>
      from <code>lsusb</code>.
    </p>
    <SearchBar id="label-q" />
  </section>

  <section class="prose" aria-labelledby="limits-h">
    <h2 id="limits-h">What it can and cannot tell</h2>
    <ul class="detection-limits">
      <li><Icon name="detect-Time02" size={32} /><div><strong>Phones</strong> are found in fastboot or ADB mode only if their id is listed. Many share a generic Google, Qualcomm, MediaTek or Samsung id: the page then lists every match and says the id is generic. Check the exact model in the phone's settings.</div></li>
      <li><Icon name="detect-CircleUnlock01" size={32} /><div><strong>USB-serial adapters</strong> (CP210x, CH340, FTDI, PL2303) and the built-in USB of chips such as the ESP32 or STM32 identify the adapter or the chip, not the device. Search by the device's label instead.</div></li>
      <li><Icon name="detect-AiCoEditing" size={32} /><div><strong>Several matches</strong> mean the same id is used by several products (one chip, one vendor id reused). Compare the names with your device.</div></li>
      <li><Icon name="detect-BookOpen01" size={32} /><div><strong>Not every device appears</strong> in the browser's list: keyboards, mice and storage are hidden by the browser, and a device may need to be woken or in pairing mode.</div></li>
      <li><Icon name="detect-BookOpen01" size={32} /><div><strong>No match</strong> does not mean nothing is known: try the label search, or request the device so others can add a 👍.</div></li>
    </ul>
  </section>

  <script>
    import "../scripts/detect.ts";
  </script>
</Base>
