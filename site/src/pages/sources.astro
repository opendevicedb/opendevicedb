---
import Base from "../layouts/Base.astro";
import { db } from "../lib/data.ts";
const { snapshots, sources } = db();
const curated = sources.get("curated")!;
const list = [...snapshots].sort((a, b) => (sources.get(b.source)?.count ?? 0) - (sources.get(a.source)?.count ?? 0));
const fmt = (n: number) => n.toLocaleString("en");
---
<Base title="Sources" description="The community databases OpenDeviceDB aggregates, with their licenses and snapshot dates.">
  <div class="page-head">
    <h1>Sources</h1>
    <p class="lede">
      Most of what OpenDeviceDB knows comes from community projects that did the work first.
      We aggregate them so one lookup covers every category — we don't compete with them.
      Every imported record links back to its source; fixes to imported data belong upstream.
    </p>
  </div>

  {list.length === 0 ? (
    <p class="empty">No imported source yet. Importers live in <code>packages/importers</code>; run <code>npm run import -- all</code>.</p>
  ) : (
    <div class="source-grid">
      {list.map((s) => (
        <article class="card source-card" id={s.source}>
          <h2><a href={s.url}>{s.name}</a></h2>
          <p class="small muted mono" style="margin:0 0 8px">{s.url.replace(/^https?:\/\//, "")}</p>
          <dl class="facts">
            <dt>Records</dt><dd><a href={`/devices/?source=${encodeURIComponent(s.source)}`}>{fmt(sources.get(s.source)?.count ?? 0)}</a></dd>
            <dt>License</dt><dd>{s.license}</dd>
            <dt>Fetched</dt><dd><time datetime={s.fetched_at}>{s.fetched_at.slice(0, 10)}</time></dd>
            <dt>Source id</dt><dd class="mono">{s.source}</dd>
          </dl>
        </article>
      ))}
    </div>
  )}

  <h2 id="curated" class="section-title curated">Curated records</h2>
  <p class="prose">
    <a href={`/devices/?source=curated`}>{fmt(curated.count)} records</a> are written directly in this repository
    (<a href={curated.url}><code>data/devices/</code></a>), by people and their agents, under {curated.license}.
    They override and enrich imported records for the same device.
  </p>
  <p class="small muted">Machine-readable: <a href="/api/sources.json">/api/sources.json</a>.</p>
</Base>

<style>
  .source-grid { display: grid; gap: var(--space-card-gap); }
  @media (min-width: 40rem) { .source-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64rem) { .source-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .source-card h2 { margin: 0 0 4px; font: 600 var(--text-title) / 1.3 var(--font); letter-spacing: -0.02em; }
  .curated { margin: var(--space-section-y) 0 16px; }
</style>
