---
import { SITE_NAME } from "../lib/config.ts";
interface Props { footer?: boolean }
const { footer = false } = Astro.props;
const prefix = Astro.url.pathname.startsWith("/detect") ? "detect" : "home";
---
<a class="brand" href="/" aria-label={`${SITE_NAME} home`}>
  <span class="brand-icon" aria-hidden="true"><img src={`/design/${prefix}-${footer ? "Group48" : "Group47"}.svg`} width="36" height="29" alt="" /></span>
  <span>{SITE_NAME}</span>
</a>
