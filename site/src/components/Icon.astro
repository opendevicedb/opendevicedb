---
// Inline SVG icon (no icon font, no extra request). Names live in lib/icons.ts.
import { ICONS } from "../lib/icons.ts";
interface Props { name: string; size?: number; class?: string }
const { name, size = 20, class: cls } = Astro.props;
const body = ICONS[name];
if (!body) throw new Error(`Unknown icon "${name}"`);
---
<svg class:list={["icon", cls]} width={size} height={size} viewBox="0 0 24 24" fill="none" aria-hidden="true" set:html={body} />
