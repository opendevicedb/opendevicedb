---
// Inline SVG icon (no icon font, no extra request). Names live in lib/icons.ts.
import { ICONS, type IconName } from "../lib/icons.ts";
import { svgIcon } from "../lib/icons-device.ts";
interface Props { name: IconName; size?: number; class?: string }
const { name, size = 20, class: cls } = Astro.props;
---
<Fragment set:html={svgIcon(ICONS[name], size, cls)} />
