{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "odb-composition/1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+/[a-z0-9-]+$",
      "maxLength": 160
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "maxLength": 80
          },
          "component": {
            "type": "string",
            "pattern": "^[a-z0-9-]+/[a-z0-9-]+$",
            "maxLength": 160
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          },
          "parameters": {
            "type": "object",
            "maxProperties": 64,
            "propertyNames": {
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "additionalProperties": {
              "type": [
                "number",
                "string",
                "boolean"
              ]
            }
          }
        },
        "required": [
          "id",
          "component",
          "version",
          "parameters"
        ]
      },
      "minItems": 1,
      "maxItems": 64
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*$",
            "maxLength": 160
          },
          "to": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*$",
            "maxLength": 160
          }
        },
        "required": [
          "from",
          "to"
        ]
      },
      "maxItems": 256
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "application": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "x": {
                "type": "integer",
                "minimum": 0,
                "maximum": 11
              },
              "y": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "width": {
                "type": "integer",
                "minimum": 1,
                "maximum": 12
              },
              "height": {
                "type": "integer",
                "minimum": 1,
                "maximum": 24
              }
            },
            "required": [
              "x",
              "y",
              "width",
              "height"
            ]
          }
        }
      },
      "required": [
        "application"
      ]
    },
    "lock": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "component": {
            "type": "string",
            "pattern": "^[a-z0-9-]+/[a-z0-9-]+$",
            "maxLength": 160
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          },
          "manifest_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "artifact_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "component",
          "version",
          "manifest_sha256"
        ]
      },
      "maxItems": 64
    },
    "purpose": {
      "enum": [
        "application",
        "example"
      ]
    },
    "devices": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+/[a-z0-9-]+$"
      },
      "uniqueItems": true
    }
  },
  "required": [
    "format",
    "id",
    "title",
    "description",
    "nodes",
    "connections",
    "layout"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
